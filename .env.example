NODE_ENV=development
NUXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgres://portfolio:portfolio@localhost:55432/portfolio
NUXT_SESSION_PASSWORD=
NUXT_LIBRE_TRANSLATE_URL=http://127.0.0.1:5500
NUXT_LIBRE_TRANSLATE_API_KEY=
NUXT_LIBRE_TRANSLATE_TIMEOUT_MS=30000
ADMIN_EMAIL=
ADMIN_PASSWORD=
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
# İsteğe bağlı mevcut AWS değişken adları; S3_REGION/S3_BUCKET boşsa kullanılır.
AWS_REGION=
AWS_S3_BUCKET_NAME=
# AWS SDK, aşağıdaki standart kimlik bilgisi değişkenlerini otomatik okur.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_BASE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFICATION_EMAIL=
RATE_LIMIT_ENABLED=true
